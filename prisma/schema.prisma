generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  source      String
  fullName    String
  phone       String
  schoolName  String?
  city        String?
  enquiryType String?
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Order {
  id               String   @id @default(cuid())
  customerName     String
  phone            String
  email            String?
  schoolOrOrg      String?
  address          String
  items            Json
  subtotal         Int
  gstAmount        Int
  deliveryFee      Int      @default(0)
  totalAmount      Int
  paymentStatus    String   @default("pending_verification")
  orderStatus      String   @default("processing")
  paymentProofNote String?
  createdAt        DateTime @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String
  price         Int
  originalPrice Int?
  images        String[]
  rating        Float    @default(4.5)
  reviewCount   Int      @default(0)
  badge         String?
  stock         Int      @default(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}