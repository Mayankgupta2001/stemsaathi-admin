generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id          String   @id @default(cuid())
  source      String
  fullName    String
  phone       String
  schoolName  String?
  city        String?
  enquiryType String?
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model Order {
  id               String   @id @default(cuid())
  customerName     String
  phone            String
  email            String?
  schoolOrOrg      String?
  address          String
  items            Json
  subtotal         Int
  gstAmount        Int
  deliveryFee      Int      @default(0)
  totalAmount      Int
  paymentStatus    String   @default("pending_verification")
  orderStatus      String   @default("processing")
  paymentProofNote String?
  createdAt        DateTime @default(now())
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String
  category      String
  price         Int
  originalPrice Int?
  images        String[]
  rating        Float    @default(4.5)
  reviewCount   Int      @default(0)
  badge         String?
  stock         Int      @default(100)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── LMS Models (mirrored from stemsaathi-backend — same DB, no migration here) ─

model Student {
  id               String       @id @default(cuid())
  name             String
  email            String       @unique
  passwordHash     String
  phone            String?
  isVerified       Boolean      @default(false)
  accountType      String       @default("INDIVIDUAL")
  organizationName String?
  organizationType String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  enrollments      Enrollment[]
  payments         Payment[]
  progress         Progress[]
}

model Course {
  id          String       @id @default(cuid())
  title       String
  description String
  thumbnail   String?
  price       Int          @default(0)
  isPublished Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  modules     Module[]
  enrollments Enrollment[]
  payments    Payment[]
}

model Module {
  id        String   @id @default(cuid())
  title     String
  order     Int
  courseId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons   Lesson[]
}

model Lesson {
  id        String     @id @default(cuid())
  title     String
  order     Int
  content   String?
  videoUrl  String?
  moduleId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  module    Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress  Progress[]
  resources Resource[]
}

model Enrollment {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  status    String   @default("active")
  paymentId String?  @unique
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id])

  @@unique([studentId, courseId])
}

model Payment {
  id                   String      @id @default(cuid())
  studentId            String
  courseId             String
  amount               Int
  currency             String      @default("INR")
  status               String      @default("pending")
  gatewayName          String?
  gatewayOrderId       String?
  gatewayTransactionId String?
  createdAt            DateTime    @default(now())
  student              Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course               Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollment           Enrollment?
}

model Progress {
  id          String    @id @default(cuid())
  studentId   String
  lessonId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  type      String   @default("pdf")
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}